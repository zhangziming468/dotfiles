binds {
    // === Overview ===
    Mod+Tab repeat=false { toggle-overview; }

    // === Application Launchers ===
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "ghostty"; }
    Mod+D hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }
    Mod+X hotkey-overlay-title="Power Menu: Toggle" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+A hotkey-overlay-title="Control Center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+Space hotkey-overlay-title="Dash" { spawn "dms" "ipc" "call" "dash" "toggle" ""; }
    Mod+Shift+C hotkey-overlay-title="Color Picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }
    Mod+Alt+I hotkey-overlay-title="Idle Inhibit" { spawn "dms" "ipc" "call" "inhibit" "toggle"; }
    Mod+S hotkey-overlay-title="Settings" {
        spawn "dms" "ipc" "call" "settings" "focusOrToggle";
    }
	  Mod+Shift+S hotkey-overlay-title="launch Steam++" {
	    	spawn "/home/zhang/WattToolkit/Steam++.sh";
	  }
	  Mod+B hotkey-overlay-title="launch Firefox" {
	    	spawn "firefox";
	  }

    // === Security ===
    Ctrl+Alt+Period hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "focusOrToggle";
    }

    // === Audio Controls ===
    Mod+Equal allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "increment" "3";
    }
    Mod+Minus allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "decrement" "3";
    }
    Mod+Delete allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "mute";
    }

    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { fullscreen-window; }

    // === Focus Navigation ===
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    // === Window Movement ===
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Monitor Navigation ===
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // === Workspace Navigation ===
    Mod+J              { focus-workspace-down; }
    Mod+K              { focus-workspace-up; }
    Mod+Alt+J         { move-column-to-workspace-down; }
    Mod+Alt+K         { move-column-to-workspace-up; }

    // === Move Workspaces ===
    Mod+Shift+J         { move-workspace-down; }
    Mod+Shift+K         { move-workspace-up; }

    // === Numbered Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // === Move to Numbered Workspaces ===
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // === Manual Sizing ===
    Mod+U { set-column-width "-10%"; }
    Mod+I { set-column-width "+10%"; }

    // === Screenshots ===
    Print hotkey-overlay-title="Screenshot: Region" { spawn "dms" "screenshot"; }
    Ctrl+Print hotkey-overlay-title="Screenshot: Full Screen" { spawn "dms" "screenshot" "full"; }
    Mod+Print hotkey-overlay-title="Screenshot: Window" { spawn "dms" "screenshot" "window"; }

    // === Display Profiles ===
    Mod+P hotkey-overlay-title="Cycle Display Profile" {
        spawn "dms" "ipc" "outputs" "cycleProfile";
    }

    // === System Controls ===
    Mod+Shift+P { power-off-monitors; }
}
